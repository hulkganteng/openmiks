<UserControl x:Class="Openmiks.Controls.VirtualSetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Openmiks.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="540" d:DesignWidth="960">
    <Grid Background="#08080A" ClipToBounds="True">
        <!-- Virtual Set Camera Viewport Container -->
        <Grid x:Name="CameraViewport" Width="960" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CameraScale" ScaleX="1.0" ScaleY="1.0" CenterX="480" CenterY="270"/>
                    <TranslateTransform x:Name="CameraTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Dynamic Composed Layers Container -->
            <Canvas x:Name="LayersCanvas" Width="960" Height="540"/>
        </Grid>
    </Grid>
</UserControl>
