<Window x:Class="Openmiks.Views.ObjectEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Openmiks.Controls"
        Title="Edit Objek / Transform - Openmiks (vMix + OBS Mode)"
        Icon="pack://application:,,,/Assets/openmiks_icon.png"
        Height="700" Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="#121316" Foreground="#F3F4F6">

    <Window.Resources>
        <Style x:Key="TactileBtn" TargetType="Button">
            <Setter Property="Background" Value="#22242B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#383D4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PresetBtn" TargetType="Button" BasedOn="{StaticResource TactileBtn}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="50"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Footer -->
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER BAR -->
        <Border Grid.Row="0" Background="#181A20" BorderBrush="#262A36" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="TRANSFORM" Foreground="#000000" FontWeight="Black" FontSize="10"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="EDIT OBJEK: INPUT 1" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Dual Mode Segmented Switcher -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#101216" BorderBrush="#262A36" BorderThickness="1" CornerRadius="4" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeDualRadio" Content="🔲 Dual (OBS Canvas + vMix Sliders)" IsChecked="True" Checked="ModeRadio_Checked"
                                     Foreground="#E2E8F0" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" Padding="8,4" Cursor="Hand"/>
                        <RadioButton x:Name="ModeObsRadio" Content="🎥 OBS Mode (Interactive Canvas)" Checked="ModeRadio_Checked"
                                     Foreground="#EF4444" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" Padding="8,4" Cursor="Hand"/>
                        <RadioButton x:Name="ModeVmixRadio" Content="🎛️ vMix Mode (Sliders &amp; Parameters)" Checked="ModeRadio_Checked"
                                     Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Padding="8,4" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ResetAll_Click" Style="{StaticResource TactileBtn}" Background="#2B1E1E" BorderBrush="#7F1D1D" Foreground="#FCA5A5" Content="🔄 Reset All" Margin="0,0,6,0"/>
                    <Button Click="Done_Click" Style="{StaticResource TactileBtn}" Background="#064E3B" BorderBrush="#059669" Foreground="#A7F3D0" FontWeight="Bold" Content="✔ Done"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN BODY (LEFT: OBS INTERACTIVE CANVAS | RIGHT: VMIX NUMERIC SLIDERS) -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <!-- OBS Interactive Viewport Canvas -->
                <ColumnDefinition x:Name="CanvasCol" Width="6*"/>
                <ColumnDefinition Width="8"/>
                <!-- vMix Numeric Parameter Sliders -->
                <ColumnDefinition x:Name="SlidersCol" Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: OBS INTERACTIVE CANVAS VIEWPORT -->
            <Border Grid.Column="0" Background="#0C0D10" BorderBrush="#262A36" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Viewport Top Toolbar -->
                    <Border Grid.Row="0" Background="#16181F" CornerRadius="4,4,0,0" Padding="8,6" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0"/>
                                <TextBlock Text="OBS INTERACTIVE VIEWPORT (16:9)" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="• Drag body to move, drag handles to resize, hold Alt to crop" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="CropToggleBtn" Content="✂ Crop Tool (Alt)" Click="CropToggle_Click"
                                              Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" Padding="8,3" FontSize="10" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Interactive Viewport with 16:9 Aspect Ratio Container -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="960" Height="540" Background="#060709" ClipToBounds="True">
                            <!-- Background Checkerboard Grid for Alpha / Transparency -->
                            <Rectangle Stroke="#1E232E" StrokeThickness="1" Fill="#0A0B0E"/>

                            <!-- Source Render Surface -->
                            <controls:InputDisplay x:Name="ViewportDisplay" />

                            <!-- OBS Interactive Gizmo Overlay -->
                            <controls:ObsTransformGizmo x:Name="ViewportGizmo" />
                        </Grid>
                    </Viewbox>

                    <!-- Viewport Footer Status -->
                    <Border Grid.Row="2" Background="#14161C" CornerRadius="0,0,4,4" Padding="8,4" Margin="0,6,0,0">
                        <Grid>
                            <TextBlock x:Name="CoordsStatusText" Text="Pan: (0.00, 0.00) | Zoom: 100% | Crop: L:0% R:0% T:0% B:0%" Foreground="#94A3B8" FontSize="10" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                            <TextBlock Text="1920x1080 Native Canvas" Foreground="#475569" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter between OBS Viewport and vMix Controls -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#1E232E"/>

            <!-- RIGHT: VMIX NUMERIC PARAMETER CONTROLS -->
            <Border Grid.Column="2" Background="#15171D" BorderBrush="#262A36" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Section Header -->
                        <Border Background="#1C1F28" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎛️ vMix POSITION &amp; TRANSFORM" Foreground="#38BDF8" FontWeight="Black" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- PAN X & Y (Position) -->
                        <TextBlock Text="POSITION (PAN X / Y)" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pan X:" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="PanXSlider" Grid.Column="1" Minimum="-1.5" Maximum="1.5" SmallChange="0.01" Value="0.0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox x:Name="PanXText" Grid.Column="2" Text="0.00" Background="#101216" Foreground="#FFF" BorderBrush="#2A2F3D" Padding="2" FontSize="10" TextAlignment="Center" LostFocus="Text_LostFocus" KeyDown="Text_KeyDown"/>
                            <Button Grid.Column="3" Click="ResetPanX_Click" Style="{StaticResource PresetBtn}" Content="0" Margin="4,0,0,0" ToolTip="Center X"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pan Y:" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="PanYSlider" Grid.Column="1" Minimum="-1.5" Maximum="1.5" SmallChange="0.01" Value="0.0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox x:Name="PanYText" Grid.Column="2" Text="0.00" Background="#101216" Foreground="#FFF" BorderBrush="#2A2F3D" Padding="2" FontSize="10" TextAlignment="Center" LostFocus="Text_LostFocus" KeyDown="Text_KeyDown"/>
                            <Button Grid.Column="3" Click="ResetPanY_Click" Style="{StaticResource PresetBtn}" Content="0" Margin="4,0,0,0" ToolTip="Center Y"/>
                        </Grid>

                        <!-- ZOOM / SCALE -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="SCALE / ZOOM" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <CheckBox x:Name="LockAspectCheck" Content="🔗 Link Zoom X/Y" IsChecked="True" Foreground="#38BDF8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zoom X:" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="ZoomXSlider" Grid.Column="1" Minimum="0.1" Maximum="3.0" SmallChange="0.05" Value="1.0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox x:Name="ZoomXText" Grid.Column="2" Text="1.00" Background="#101216" Foreground="#FFF" BorderBrush="#2A2F3D" Padding="2" FontSize="10" TextAlignment="Center" LostFocus="Text_LostFocus" KeyDown="Text_KeyDown"/>
                            <Button Grid.Column="3" Click="ResetZoom_Click" Style="{StaticResource PresetBtn}" Content="1.0" Margin="4,0,0,0" ToolTip="100% Zoom"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zoom Y:" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="ZoomYSlider" Grid.Column="1" Minimum="0.1" Maximum="3.0" SmallChange="0.05" Value="1.0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox x:Name="ZoomYText" Grid.Column="2" Text="1.00" Background="#101216" Foreground="#FFF" BorderBrush="#2A2F3D" Padding="2" FontSize="10" TextAlignment="Center" LostFocus="Text_LostFocus" KeyDown="Text_KeyDown"/>
                            <Button Grid.Column="3" Click="ResetZoom_Click" Style="{StaticResource PresetBtn}" Content="1.0" Margin="4,0,0,0" ToolTip="100% Zoom"/>
                        </Grid>

                        <!-- ROTATION -->
                        <TextBlock Text="ROTATION (DEGREES)" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Angle:" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="RotationSlider" Grid.Column="1" Minimum="-180" Maximum="180" Value="0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox x:Name="RotationText" Grid.Column="2" Text="0°" Background="#101216" Foreground="#FFF" BorderBrush="#2A2F3D" Padding="2" FontSize="10" TextAlignment="Center" LostFocus="Text_LostFocus" KeyDown="Text_KeyDown"/>
                            <Button Grid.Column="3" Click="ResetRotation_Click" Style="{StaticResource PresetBtn}" Content="0°" Margin="4,0,0,0" ToolTip="Reset Angle"/>
                        </Grid>

                        <!-- CROP (X1, Y1, X2, Y2) -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="CROP (LEFT, RIGHT, TOP, BOTTOM)" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <Button Click="ResetCrop_Click" Style="{StaticResource PresetBtn}" Content="Reset Crop" HorizontalAlignment="Right" Padding="4,2"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Left:" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="CropLSlider" Grid.Column="1" Minimum="0.0" Maximum="0.8" Value="0.0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CropLText" Grid.Column="2" Text="0%" Foreground="#22C55E" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Right:" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="CropRSlider" Grid.Column="1" Minimum="0.0" Maximum="0.8" Value="0.0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CropRText" Grid.Column="2" Text="0%" Foreground="#22C55E" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Top:" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="CropTSlider" Grid.Column="1" Minimum="0.0" Maximum="0.8" Value="0.0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CropTText" Grid.Column="2" Text="0%" Foreground="#22C55E" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bottom:" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="CropBSlider" Grid.Column="1" Minimum="0.0" Maximum="0.8" Value="0.0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CropBText" Grid.Column="2" Text="0%" Foreground="#22C55E" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- QUICK PRESETS (vMix / OBS Standard) -->
                        <TextBlock Text="QUICK TRANSFORM PRESETS" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Click="Preset_Click" Tag="Center" Style="{StaticResource PresetBtn}" Content="🎯 Center (0,0)"/>
                            <Button Click="Preset_Click" Tag="100" Style="{StaticResource PresetBtn}" Content="⏹ 100% Zoom"/>
                            <Button Click="Preset_Click" Tag="Fit" Style="{StaticResource PresetBtn}" Content="⛶ Fit / Reset"/>
                            <Button Click="Preset_Click" Tag="Fill" Style="{StaticResource PresetBtn}" Content="🔲 Fill Screen"/>
                            <Button Click="Preset_Click" Tag="pip_br" Style="{StaticResource PresetBtn}" Content="↘ PIP Btm-Right"/>
                            <Button Click="Preset_Click" Tag="pip_bl" Style="{StaticResource PresetBtn}" Content="↙ PIP Btm-Left"/>
                            <Button Click="Preset_Click" Tag="pip_tr" Style="{StaticResource PresetBtn}" Content="↗ PIP Top-Right"/>
                            <Button Click="Preset_Click" Tag="pip_tl" Style="{StaticResource PresetBtn}" Content="↖ PIP Top-Left"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. FOOTER -->
        <Border Grid.Row="2" Background="#14161C" BorderBrush="#262A36" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Openmiks Broadcast Engine • Real-time Hardware Accelerated Transform Compositor" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                <Button Click="Done_Click" Style="{StaticResource TactileBtn}" Background="#00C853" BorderBrush="#00E676" Foreground="#FFFFFF" FontWeight="Bold" Content="Apply &amp; Close" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
