<Window x:Class="Openmiks.Views.VirtualSetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Openmiks.Controls"
        Title="Openmiks Virtual Set Editor (VSE)"
        Icon="pack://application:,,,/Assets/openmiks_icon.png"
        Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#121316" Foreground="#F3F4F6">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#38383D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="46"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#202024" BorderBrush="#2D2D32" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="VIRTUAL SET EDITOR" FontWeight="Black" FontSize="13" Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Click="NewSet_Click" Style="{StaticResource ToolBtn}" Content="New Set" Margin="0,0,6,0"/>
                    <Button Click="OpenSet_Click" Style="{StaticResource ToolBtn}" Content="Open Set..." Margin="0,0,6,0"/>
                    <Button Click="SaveSet_Click" Style="{StaticResource ToolBtn}" Background="#00C853" Foreground="#FFFFFF" BorderBrush="#00E676" Content="💾 Save Virtual Set" Margin="0,0,16,0"/>

                    <TextBlock Text="Set Name:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SetNameBox" Width="180" Background="#161618" Foreground="#FFF" BorderBrush="#38383E" Padding="6,3" VerticalAlignment="Center" Text="Studio_News"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: 3-column Layout (Layers, Interactive Canvas, Properties & Presets) -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- Left: Layer Stack -->
                <ColumnDefinition Width="240"/>
                <!-- Center: Real-Time Preview Canvas -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Properties & Camera Presets -->
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 1. LEFT: LAYER LIST -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LAYERS (Z-STACK)" Foreground="#AAAAAA" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                    <ListBox x:Name="LayersList" Grid.Row="1" Background="#121214" BorderBrush="#26262B" Foreground="#FFF"
                             SelectionChanged="LayersList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="☰ " Foreground="#666" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#26262B" CornerRadius="2" Padding="4,1">
                                        <TextBlock Text="{Binding PlaceholderType}" FontSize="9" Foreground="#00E676"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add / Remove Layer Buttons -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="AddLayerPng_Click" Style="{StaticResource ToolBtn}" Content="+ Import PNG" Margin="0,0,2,0"/>
                        <Button Grid.Column="1" Click="AddTalentLayer_Click" Style="{StaticResource ToolBtn}" Content="+ Talent" Margin="2,0,2,0"/>
                        <Button Grid.Column="2" Click="MoveLayerUp_Click" Style="{StaticResource ToolBtn}" Content="▲" Margin="2,0,2,0" ToolTip="Move Layer Up"/>
                        <Button Grid.Column="3" Click="RemoveLayer_Click" Style="{StaticResource ToolBtn}" Content="✕" Margin="2,0,0,0" ToolTip="Delete Layer" Background="#7F1D1D" Foreground="#FCA5A5"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. CENTER: COMPOSITED PREVIEW VIEWPORT -->
            <Border Grid.Column="1" Background="#111114" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="4" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E22" Padding="8,4">
                        <TextBlock Text="COMPOSITED SET VIEWPORT (16:9)" Foreground="#888" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <!-- Virtual Set Compositor View -->
                    <controls:VirtualSetView x:Name="SetPreviewView" Grid.Row="1" />

                    <!-- Camera Preset Quick Switch Buttons -->
                    <Border Grid.Row="2" Background="#18181B" Padding="8,4">
                        <StackPanel x:Name="CameraPresetBar" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CAMERA PRESETS: " Foreground="#888" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Dynamic preset buttons injected in code -->
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. RIGHT: SELECTED LAYER PROPERTIES & CHROMA KEY -->
            <Border Grid.Column="2" Background="#18181B" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="4" Padding="10" Margin="4,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="LAYER PROPERTIES" Foreground="#AAAAAA" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>

                        <TextBlock Text="Layer Name:" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="PropLayerName" Background="#161618" Foreground="#FFF" BorderBrush="#38383E" Padding="4" Margin="0,0,0,8" TextChanged="Prop_Changed"/>

                        <TextBlock Text="Placeholder Type:" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox x:Name="PropTypeCombo" Margin="0,0,0,10" SelectionChanged="PropType_Changed">
                            <ComboBoxItem Content="Background (Static)"/>
                            <ComboBoxItem Content="Talent (Live Presenter)"/>
                            <ComboBoxItem Content="Screen (Video / Display)"/>
                            <ComboBoxItem Content="Foreground / Overlay"/>
                        </ComboBox>

                        <!-- Transform (X, Y, Zoom, Rotation) -->
                        <TextBlock Text="Position X (-1.0 to 1.0):" Foreground="#888" FontSize="10"/>
                        <Slider x:Name="PropXSlider" Minimum="-1.0" Maximum="1.0" Value="0" ValueChanged="Prop_Changed" Margin="0,2,0,6"/>

                        <TextBlock Text="Position Y (-1.0 to 1.0):" Foreground="#888" FontSize="10"/>
                        <Slider x:Name="PropYSlider" Minimum="-1.0" Maximum="1.0" Value="0" ValueChanged="Prop_Changed" Margin="0,2,0,6"/>

                        <TextBlock Text="Scale / Zoom (0.1 to 3.0):" Foreground="#888" FontSize="10"/>
                        <Slider x:Name="PropZoomSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="Prop_Changed" Margin="0,2,0,6"/>

                        <TextBlock Text="Opacity (0.0 to 1.0):" Foreground="#888" FontSize="10"/>
                        <Slider x:Name="PropOpacitySlider" Minimum="0.0" Maximum="1.0" Value="1.0" ValueChanged="Prop_Changed" Margin="0,2,0,12"/>

                        <!-- Chroma Key Engine Settings -->
                        <Border Background="#202026" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="PropChromaCheck" Content="Enable GPU Chroma Key" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8" Checked="Prop_Changed" Unchecked="Prop_Changed"/>

                                <TextBlock Text="Similarity Threshold:" Foreground="#AAA" FontSize="10"/>
                                <Slider x:Name="PropSimilaritySlider" Minimum="0.05" Maximum="0.9" Value="0.38" ValueChanged="Prop_Changed" Margin="0,2,0,6"/>

                                <TextBlock Text="Smoothness / Edge Feather:" Foreground="#AAA" FontSize="10"/>
                                <Slider x:Name="PropSmoothnessSlider" Minimum="0.01" Maximum="0.5" Value="0.10" ValueChanged="Prop_Changed" Margin="0,2,0,6"/>

                                <TextBlock Text="Spill Suppression (Green Spill):" Foreground="#AAA" FontSize="10"/>
                                <Slider x:Name="PropSpillSlider" Minimum="0.0" Maximum="1.0" Value="0.80" ValueChanged="Prop_Changed" Margin="0,2,0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Camera Presets Section -->
                        <TextBlock Text="CAMERA PRESETS" Foreground="#AAAAAA" FontWeight="Bold" FontSize="11" Margin="0,6,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Click="AddPreset_Click" Style="{StaticResource ToolBtn}" Content="+ Save Current Shot as Preset" Padding="8,4"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#18181A" BorderBrush="#25252A" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready | VSE format fully compatible with vMix Virtual Sets" Foreground="#71717A" FontSize="10"/>
                <TextBlock Text="HLSL Direct3D 11 Chroma Key Engine Active" Foreground="#00E676" FontSize="10" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
