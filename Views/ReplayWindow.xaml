<Window x:Class="Openmiks.Views.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Openmiks.Controls"
        Title="Openmiks 8-Camera Instant Replay &amp; VAR"
        Icon="pack://application:,,,/Assets/openmiks_icon.png"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#121316" Foreground="#F3F4F6">

    <Window.Resources>
        <Style x:Key="RBtn" TargetType="Button">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#38383D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Replay Bar -->
            <RowDefinition Height="46"/>
            <!-- Center Monitors & 8-Camera Grid -->
            <RowDefinition Height="*"/>
            <!-- Bottom Controls & Event Table -->
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#1E1E22" BorderBrush="#2C2C32" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#E65100" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="REPLAY" FontWeight="Black" FontSize="12" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock Text="8-CAMERA MULTI-ANGLE SYSTEM" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Button x:Name="RecReplayBtn" Click="RecReplay_Click" Style="{StaticResource RBtn}" Background="#991B1B" BorderBrush="#EF4444" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ReplayDot" Width="8" Height="8" Fill="#FFF" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ReplayRecText" Text="REC REPLAY" Foreground="#FFF"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#25252A" CornerRadius="3" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="SessionTimeText" Text="SESSION: 00:00:00" Foreground="#00E676" FontWeight="Bold" FontSize="11" FontFamily="Consolas, monospace"/>
                    </Border>
                </StackPanel>

                <!-- Quick Highlight triggers -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="Quick10s_Click" Style="{StaticResource RBtn}" Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFF" Content="⚡ LAST 10s" Margin="0,0,6,0"/>
                    <Button Click="Quick5s_Click" Style="{StaticResource RBtn}" Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFF" Content="⚡ LAST 5s" Margin="0,0,6,0"/>
                    <Button Click="Quick20s_Click" Style="{StaticResource RBtn}" Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFF" Content="⚡ LAST 20s"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CENTER: CHANNEL A & B MONITORS + 8 CAMERAS VAR -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- Playback Channel A -->
                <ColumnDefinition Width="*"/>
                <!-- Playback Channel B -->
                <ColumnDefinition Width="*"/>
                <!-- 8-Camera MultiView Thumbnail Strip -->
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Channel A Monitor -->
            <Border Grid.Column="0" Background="#111114" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="4" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0284C7" Padding="6,2">
                        <TextBlock x:Name="ChanATitle" Text="REPLAY CHANNEL A (LIVE / CAM 1)" Foreground="#FFF" FontWeight="Bold" FontSize="10"/>
                    </Border>
                    <Grid Grid.Row="1" Background="#000">
                        <controls:InputDisplay x:Name="ChanADisplay" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#B0000000" CornerRadius="3" Padding="6,2" Margin="6">
                            <TextBlock x:Name="ChanASpeedText" Text="50% SPEED" Foreground="#F59E0B" FontWeight="Bold" FontSize="10"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="#18181B" Padding="6,2">
                        <TextBlock x:Name="ChanAPosText" Text="POS: 00:00:00.00" Foreground="#AAA" FontSize="10" FontFamily="Consolas"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Channel B Monitor -->
            <Border Grid.Column="1" Background="#111114" BorderBrush="#9333EA" BorderThickness="2" CornerRadius="4" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#9333EA" Padding="6,2">
                        <TextBlock x:Name="ChanBTitle" Text="REPLAY CHANNEL B (CAM 2)" Foreground="#FFF" FontWeight="Bold" FontSize="10"/>
                    </Border>
                    <Grid Grid.Row="1" Background="#000">
                        <controls:InputDisplay x:Name="ChanBDisplay" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#B0000000" CornerRadius="3" Padding="6,2" Margin="6">
                            <TextBlock x:Name="ChanBSpeedText" Text="100% SPEED" Foreground="#38BDF8" FontWeight="Bold" FontSize="10"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="#18181B" Padding="6,2">
                        <TextBlock x:Name="ChanBPosText" Text="POS: 00:00:00.00" Foreground="#AAA" FontSize="10" FontFamily="Consolas"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 8-Camera Thumbnails List -->
            <Border Grid.Column="2" Background="#1A1A1E" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Padding="6" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="8 CAMERA ANGLES" Foreground="#888" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CameraAnglesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Background="#24242A" BorderBrush="#38383F" BorderThickness="1" CornerRadius="3" Padding="6" Cursor="Hand" MouseLeftButtonDown="CameraAngle_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#E65100" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CameraNumber}" FontWeight="Bold" FontSize="10" Foreground="#FFF"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#DDD"/>
                                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#00E676" ToolTip="Camera Active"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM: JOG CONTROLS & EVENT TABLE -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#2A2A2E" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Transport Controls & Speeds -->
                    <ColumnDefinition Width="340"/>
                    <!-- Event List Table -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Transport Controls -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Click="MarkIn_Click" Style="{StaticResource RBtn}" Content="[ MARK IN" Background="#065F46" Foreground="#FFF" BorderBrush="#10B981" Margin="0,0,6,0"/>
                        <Button Click="MarkOut_Click" Style="{StaticResource RBtn}" Content="MARK OUT ]" Background="#7F1D1D" Foreground="#FFF" BorderBrush="#EF4444" Margin="0,0,10,0"/>
                        <Button Click="LiveJump_Click" Style="{StaticResource RBtn}" Content="🔴 LIVE" Background="#991B1B" Foreground="#FFF"/>
                    </StackPanel>

                    <!-- Speed Buttons -->
                    <TextBlock Text="SLOW MOTION SPEED:" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Click="Speed_Click" Tag="1.0" Style="{StaticResource RBtn}" Content="100%" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Click="Speed_Click" Tag="0.75" Style="{StaticResource RBtn}" Content="75%" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Click="Speed_Click" Tag="0.5" Style="{StaticResource RBtn}" Content="50%" Padding="8,4" Background="#1E3A8A" Foreground="#FFF" Margin="0,0,4,0"/>
                        <Button Click="Speed_Click" Tag="0.33" Style="{StaticResource RBtn}" Content="33%" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Click="Speed_Click" Tag="0.25" Style="{StaticResource RBtn}" Content="25%" Padding="8,4"/>
                    </StackPanel>

                    <!-- Jog / Shuttle -->
                    <TextBlock Text="JOG &amp; STEP FRAME:" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Click="Jog_Click" Tag="-2.0" Style="{StaticResource RBtn}" Content="⏪ -2s" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Click="Jog_Click" Tag="-0.033" Style="{StaticResource RBtn}" Content="◀ Frame" Padding="8,4" Margin="0,0,4,0"/>
                        <Button x:Name="PlayPauseBtn" Click="PlayPause_Click" Style="{StaticResource RBtn}" Content="⏯ PLAY" Padding="12,4" Background="#065F46" Foreground="#FFF" Margin="0,0,4,0"/>
                        <Button Click="Jog_Click" Tag="0.033" Style="{StaticResource RBtn}" Content="Frame ▶" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Click="Jog_Click" Tag="2.0" Style="{StaticResource RBtn}" Content="+2s ⏩" Padding="8,4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Events Table -->
                <Border Grid.Column="1" Background="#121214" BorderBrush="#26262B" BorderThickness="1" CornerRadius="4" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="REPLAY EVENT LISTS (1-20)" Foreground="#00E676" FontWeight="Black" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="(Double click event to Cue &amp; Playback)" Foreground="#777" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid x:Name="EventsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#121214" RowBackground="#16161A" AlternatingRowBackground="#1D1D22"
                                  Foreground="#FFF" BorderThickness="0" MouseDoubleClick="EventsGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
                                <DataGridTextColumn Header="Cam" Binding="{Binding CameraNumber}" Width="50"/>
                                <DataGridTextColumn Header="In Point" Binding="{Binding InPoint, StringFormat='hh\\:mm\\:ss\\.ff'}" Width="100"/>
                                <DataGridTextColumn Header="Out Point" Binding="{Binding OutPoint, StringFormat='hh\\:mm\\:ss\\.ff'}" Width="100"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat='mm\\:ss\\.ff'}" Width="90"/>
                                <DataGridTextColumn Header="Speed" Binding="{Binding Speed, StringFormat='P0'}" Width="60"/>
                                <DataGridTextColumn Header="Description / Tag" Binding="{Binding Text}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
