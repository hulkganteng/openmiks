<UserControl x:Class="AnimatedInOutHD"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Width="1920" Height="1080" xmlns:my="clr-namespace:vMixTitleLibrary;assembly=vMixTitleLibrary">
    <UserControl.Resources>
        <Storyboard x:Key="Storyboard1" RepeatBehavior="0:0:1">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="rHeadline">
                <SplineDoubleKeyFrame KeyTime="0" Value="-1920"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="Headline">
                <SplineDoubleKeyFrame KeyTime="0" Value="-1920"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="rDescription">
                <SplineDoubleKeyFrame KeyTime="0" Value="1920"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="Description">
                <SplineDoubleKeyFrame KeyTime="0" Value="1920"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="Storyboard2" RepeatBehavior="0:0:1">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="rHeadline">
                <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="-1920"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="Headline">
                <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="-1920"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="rDescription">
                <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1920"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="Description">
                <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1920"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Storyboard1}"/>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid>
        <Rectangle Height="201" HorizontalAlignment="Center" Margin="0,879,0,0" Name="Rectangle1" Stroke="Black" VerticalAlignment="Top" Width="1920" Opacity="0.8" StrokeThickness="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF4B56A7" Offset="0" />
                    <GradientStop Color="#FF001279" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Height="144" HorizontalAlignment="Left" Margin="396,879,0,0" Name="rDescription" RadiusX="50" RadiusY="50" Stroke="Black" VerticalAlignment="Top" Width="1173" Opacity="0.9" StrokeThickness="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFB1ACAC" Offset="0" />
                    <GradientStop Color="White" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Height="129" HorizontalAlignment="Left" Margin="-43,805,0,0" Name="rHeadline" Stroke="Black" VerticalAlignment="Top" Width="1646" RadiusX="20" RadiusY="20" Opacity="1" StrokeThickness="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFDE0E0E" Offset="0" />
                    <GradientStop Color="#FF801C1C" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform />
            </Rectangle.RenderTransform>
        </Rectangle>
        <my:TextBlockDesign HorizontalAlignment="Left" Name="Headline" VerticalAlignment="Center" Width="1207" Fill="White" FontSize="90" FontWeight="Bold" Text="HEADLINE" Stroke="Black" StrokeThickness="1" FontFamily="Century Gothic" Margin="372,811,0,159" Height="300" Highlight="False">
            <my:TextBlockDesign.RenderTransform>
                <TranslateTransform />
            </my:TextBlockDesign.RenderTransform>
        </my:TextBlockDesign>
        <my:TextBlockDesign Fill="Black" FontFamily="Century Gothic" FontSize="58" FontWeight="Bold" Height="0" HorizontalAlignment="Left" Margin="440,942,0,66" Name="Description" Stroke="Black" StrokeThickness="0" Text="DESCRIPTION" VerticalAlignment="Center" Width="1094">
            <my:TextBlockDesign.RenderTransform>
                <TranslateTransform />
            </my:TextBlockDesign.RenderTransform>
        </my:TextBlockDesign>
    </Grid>
</UserControl>
