<UserControl x:Class="ScoreBoardHD2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Width="1920" Height="1080" xmlns:my="clr-namespace:vMixTitleLibrary;assembly=vMixTitleLibrary">
    <Grid>
        <Canvas>
            <Image Canvas.Left="0" Canvas.Top="0" Name="Image1" Stretch="Fill" Source="ScoreBoardHD2.xaml.png" Opacity="0.9" />
             <Border Canvas.Left="481" Canvas.Top="903" Height="70" Name="Canvas1" Width="99">
                <TextBlock FontSize="48" Foreground="White" Name="HomeScore" Text="0" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
            <Border Canvas.Left="481" Canvas.Top="977" Height="70" Name="Canvas2" Width="99">
                <TextBlock FontSize="48" Foreground="White" Name="AwayScore" Text="0" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
            <my:TextBlockDesign Canvas.Left="92" Canvas.Top="854" Name="Title" Height="29" Width="328" TextAlignment="Center" Text="Title" Fill="White" FontSize="32" FontWeight="Bold" />
            <my:TextBlockDesign Canvas.Left="71" Canvas.Top="911" Name="HomeTitle" Height="73" Width="405" HorizontalAlignment="Stretch" TextAlignment="Center" Text="Home" Stroke="Black" StrokeThickness="0" Fill="Black" FontWeight="Bold" />
            <my:TextBlockDesign Canvas.Left="71" Canvas.Top="984" Fill="Black" FontWeight="Bold" Height="73" Name="AwayTitle" Stroke="Black" StrokeThickness="0" Text="Away" TextAlignment="Center" Width="405" />
        </Canvas>
    </Grid>
</UserControl>
