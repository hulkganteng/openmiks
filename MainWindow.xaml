<Window x:Class="VMixClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VMixClone"
        xmlns:controls="clr-namespace:VMixClone.Controls"
        mc:Ignorable="d"
        Title="Openmiks 29 Pro - Production Switcher"
        Icon="pack://application:,,,/Assets/openmiks_icon.png"
        Height="840" Width="1420"
        MinHeight="680" MinWidth="1100"
        Background="#121316" Foreground="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Meter Color Gradient -->
        <LinearGradientBrush x:Key="MeterLedBrush" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#10B981" Offset="0.0"/>
            <GradientStop Color="#10B981" Offset="0.75"/>
            <GradientStop Color="#F59E0B" Offset="0.751"/>
            <GradientStop Color="#F59E0B" Offset="0.90"/>
            <GradientStop Color="#EF4444" Offset="0.901"/>
            <GradientStop Color="#EF4444" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- General Button Styles -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E2026"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D3139"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B2F38"/>
                    <Setter Property="BorderBrush" Value="#4B5563"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#15171C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Broadcast Transition Action Button -->
        <Style x:Key="TransBtn" TargetType="Button">
            <Setter Property="Background" Value="#22252D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#323742"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D333F"/>
                    <Setter Property="BorderBrush" Value="#4A5568"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#171A20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Filter Button -->
        <Style x:Key="CatBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1E24"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#2B2F3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#262A34"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Input Card Overlay 1-4 Tally Styles -->
        <Style x:Key="CardOverlay1BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#20242D"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverlay1}" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardOverlay2BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#20242D"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverlay2}" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardOverlay3BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#20242D"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverlay3}" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardOverlay4BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#20242D"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverlay4}" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hardware T-Bar Slider -->
        <Style x:Key="BroadcastTBarSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="48" HorizontalAlignment="Center">
                            <!-- Track Channel -->
                            <Border Width="8" Background="#0C0D10" BorderBrush="#262830" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center">
                                <Rectangle Width="2" Fill="#374151" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Calibration Ticks -->
                            <Canvas Width="48" IsHitTestVisible="False">
                                <Line X1="6" Y1="12" X2="14" Y2="12" Stroke="#64748B" StrokeThickness="1"/>
                                <Line X1="34" Y1="12" X2="42" Y2="12" Stroke="#64748B" StrokeThickness="1"/>
                                <Line X1="9" Y1="42" X2="14" Y2="42" Stroke="#475569" StrokeThickness="1"/>
                                <Line X1="34" Y1="42" X2="39" Y2="42" Stroke="#475569" StrokeThickness="1"/>
                                <Line X1="5" Y1="72" X2="14" Y2="72" Stroke="#F59E0B" StrokeThickness="1.5"/>
                                <Line X1="34" Y1="72" X2="43" Y2="72" Stroke="#F59E0B" StrokeThickness="1.5"/>
                                <Line X1="9" Y1="102" X2="14" Y2="102" Stroke="#475569" StrokeThickness="1"/>
                                <Line X1="34" Y1="102" X2="39" Y2="102" Stroke="#475569" StrokeThickness="1"/>
                                <Line X1="6" Y1="132" X2="14" Y2="132" Stroke="#64748B" StrokeThickness="1"/>
                                <Line X1="34" Y1="132" X2="42" Y2="132" Stroke="#64748B" StrokeThickness="1"/>
                            </Canvas>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="40" Height="22" Background="#262A33" BorderBrush="#525B6C" BorderThickness="1.5" CornerRadius="3">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Rectangle Width="2" Height="10" Fill="#64748B" Margin="2,0"/>
                                                            <Rectangle Width="2" Height="14" Fill="#F59E0B" Margin="2,0"/>
                                                            <Rectangle Width="2" Height="10" Fill="#64748B" Margin="2,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Broadcast Audio Fader Slider -->
        <Style x:Key="BroadcastFaderSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="28" HorizontalAlignment="Center">
                            <Border Width="4" Background="#0C0D10" BorderBrush="#262830" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="24" Height="15" Background="#2B2F3A" BorderBrush="#64748B" BorderThickness="1" CornerRadius="2">
                                                    <Rectangle Width="16" Height="2" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multi-segment VU Meter Style (Native WPF Vertical ProgressBar) -->
        <Style x:Key="VuProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#0A0B0E"/>
            <Setter Property="Foreground" Value="{StaticResource MeterLedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Master Header Bar -->
            <RowDefinition Height="50"/>
            <!-- 1: Dual Monitors + Transition Center + Audio Mixer -->
            <RowDefinition Height="*"/>
            <!-- 2: Overlays Hardware Bar -->
            <RowDefinition Height="36"/>
            <!-- 3: Category Filter Bar -->
            <RowDefinition Height="30"/>
            <!-- 4: Bottom Input Cards Switcher Tray -->
            <RowDefinition Height="186"/>
            <!-- 5: Status Telemetry Footer -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- 0: MASTER HEADER BAR -->
        <Border Grid.Row="0" Background="#16181D" BorderBrush="#242730" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Official Openmiks Brand & System Telemetry -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Official Openmiks Logo -->
                    <Image Source="pack://application:,,,/Assets/openmiks_logo_dark.png"
                           Height="28" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="v29 PRO" Foreground="#38BDF8" FontSize="10" FontWeight="Black"/>
                    </Border>

                    <!-- Telemetry Chips -->
                    <Border Background="#1F232B" BorderBrush="#2C323D" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                        <TextBlock x:Name="ResolutionFpsText" Text="1080p 59.94" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#1F232B" BorderBrush="#2C323D" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                        <TextBlock x:Name="SysStatsText" Text="CPU: 3%  GPU: 6%" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                    <Border Background="#1F232B" BorderBrush="#2C323D" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock x:Name="MasterClockText" Text="12:00:00" Foreground="#10B981" FontWeight="Bold" FontSize="11" FontFamily="Consolas, monospace"/>
                    </Border>

                    <!-- Preset File Actions -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Click="NewPreset_Click" Style="{StaticResource HeaderBtn}" Content="NEW" Padding="6,3" Margin="0,0,4,0" ToolTip="New Blank Preset"/>
                        <Button Click="OpenPreset_Click" Style="{StaticResource HeaderBtn}" Content="OPEN" Padding="6,3" Margin="0,0,4,0" ToolTip="Open .vmix Preset File"/>
                        <Button Click="SavePreset_Click" Style="{StaticResource HeaderBtn}" Content="SAVE" Padding="6,3" Margin="0,0,4,0" ToolTip="Save .vmix Preset File"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Web Controller & Remote Tally Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Click="WebControllerLink_Click" Style="{StaticResource HeaderBtn}" Background="#0F241A" BorderBrush="#10B981" Foreground="#10B981" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📱 WEB CONTROLLER:" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock x:Name="WebUrlText" Text="http://localhost:8088/controller" FontWeight="Normal" TextDecorations="Underline"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Broadcast Action Bank -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RecordBtn" Click="RecordBtn_Click" Style="{StaticResource HeaderBtn}" Margin="0,0,6,0" MinWidth="92">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="#64748B" Margin="0,0,6,0"/>
                            <TextBlock x:Name="RecText" Text="RECORD" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StreamBtn" Click="StreamBtn_Click" Style="{StaticResource HeaderBtn}" Margin="0,0,6,0" MinWidth="96">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StreamDot" Width="8" Height="8" Fill="#64748B" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StreamText" Text="STREAM" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExternalBtn" Click="ExternalBtn_Click" Style="{StaticResource HeaderBtn}" Content="EXTERNAL" Margin="0,0,6,0"/>
                    <Button Click="FullscreenBtn_Click" Style="{StaticResource HeaderBtn}" Content="FULLSCREEN" Margin="0,0,6,0"/>
                    <Button Click="OpenMultiView_Click" Style="{StaticResource HeaderBtn}" Content="⛶ MULTIVIEW" Margin="0,0,6,0" ToolTip="MultiView Output Display"/>
                    <Button Click="OpenReplay_Click" Style="{StaticResource HeaderBtn}" Content="⚡ REPLAY" Margin="0,0,6,0" ToolTip="8-Camera Instant Replay &amp; VAR System"/>
                    <Button Click="OpenVse_Click" Style="{StaticResource HeaderBtn}" Content="🎨 VSE" Margin="0,0,6,0" ToolTip="Open Virtual Set Editor"/>
                    <Button Click="Settings_Click" Style="{StaticResource HeaderBtn}" Content="⚙ SETTINGS" Margin="0,0,6,0"/>
                    <Button Click="AddInput_Click" Style="{StaticResource HeaderBtn}" Background="#059669" BorderBrush="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Content="+ ADD INPUT"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: DUAL MONITORS & TRANSITION ROW -->
        <Grid Grid.Row="1" Margin="8,6,8,4">
            <Grid.ColumnDefinitions>
                <!-- Preview Monitor -->
                <ColumnDefinition Width="*"/>
                <!-- Transition Center & T-Bar -->
                <ColumnDefinition Width="205"/>
                <!-- Program Monitor -->
                <ColumnDefinition Width="*"/>
                <!-- Audio Mixer Panel -->
                <ColumnDefinition Width="185"/>
            </Grid.ColumnDefinitions>

            <!-- 1. PREVIEW MONITOR -->
            <Border Grid.Column="0" Background="#14161C" BorderBrush="#10B981" BorderThickness="2" CornerRadius="4" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Header Bar with LED Tally Badge -->
                    <Border Grid.Row="0" Background="#181B22" BorderBrush="#252A36" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0"/>
                                        <TextBlock Text="PREVIEW" Foreground="#10B981" FontWeight="Black" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <ToggleButton x:Name="PreviewObsEditToggle" Content="🎥 OBS Edit Mode" Click="PreviewObsEditToggle_Click"
                                              Background="#1E232E" Foreground="#EF4444" BorderBrush="#3B4252" Padding="6,2" FontSize="9" FontWeight="Bold" Margin="0,0,4,0" Cursor="Hand"
                                              ToolTip="Toggle OBS interactive bounding box on Preview (move, resize, crop)"/>
                                <Button Click="OpenPreviewObjectEdit_Click" Content="🎛️ Transform"
                                        Background="#1E232E" Foreground="#38BDF8" BorderBrush="#3B4252" Padding="6,2" FontSize="9" FontWeight="Bold" Cursor="Hand"
                                        ToolTip="Open full dual-mode Object Editor (vMix Sliders + OBS Viewport)"/>
                            </StackPanel>
                            <TextBlock x:Name="PreviewInputName" Text="1. Color Bars" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Preview Canvas -->
                    <Border Grid.Row="1" Background="#07080A" ClipToBounds="True">
                        <Grid>
                            <controls:InputDisplay x:Name="PreviewDisplay" />
                            <controls:ObsTransformGizmo x:Name="PreviewGizmo" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Preview Footer -->
                    <Border Grid.Row="2" Background="#16181F" Padding="8,2">
                        <Grid>
                            <TextBlock Text="NEXT ACTIVE TRANSITION TARGET" Foreground="#64748B" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="1080p 59.94p • 16:9" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. TRANSITION CENTER & T-BAR -->
            <Border Grid.Column="1" Background="#191B22" BorderBrush="#272B35" BorderThickness="1" CornerRadius="4" Margin="4,0,4,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Transition Buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- Duration Controls -->
                        <RowDefinition Height="Auto"/>
                        <!-- T-Bar Area -->
                        <RowDefinition Height="*"/>
                        <!-- FTB Button -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Transition Buttons Grid -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Big CUT Button (Full width) -->
                        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Click="Cut_Click" Style="{StaticResource TransBtn}" Background="#991B1B" BorderBrush="#EF4444" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CUT" FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                <TextBlock Text=" [Space]" FontSize="10" Foreground="#FECACA" Margin="4,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Row 1: FADE and MERGE -->
                        <Button Grid.Row="1" Grid.Column="0" Click="Fade_Click" Style="{StaticResource TransBtn}" Background="#0E7490" BorderBrush="#06B6D4" Margin="0,0,2,3">
                            <TextBlock Text="FADE" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Click="Merge_Click" Style="{StaticResource TransBtn}" Background="#047857" BorderBrush="#10B981" Margin="2,0,0,3">
                            <TextBlock Text="MERGE" FontSize="11" FontWeight="Bold"/>
                        </Button>

                        <!-- Row 2: ZOOM and WIPE -->
                        <Button Grid.Row="2" Grid.Column="0" Click="Zoom_Click" Style="{StaticResource TransBtn}" Background="#1D4ED8" BorderBrush="#3B82F6" Margin="0,0,2,3">
                            <TextBlock Text="ZOOM" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="1" Click="Wipe_Click" Style="{StaticResource TransBtn}" Background="#6D28D9" BorderBrush="#8B5CF6" Margin="2,0,0,3">
                            <TextBlock Text="WIPE" FontSize="11" FontWeight="Bold"/>
                        </Button>

                        <!-- Row 3: SLIDE and BARNDOOR -->
                        <Button Grid.Row="3" Grid.Column="0" Click="Slide_Click" Style="{StaticResource TransBtn}" Background="#C2410C" BorderBrush="#F97316" Margin="0,0,2,0">
                            <TextBlock Text="SLIDE" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="1" Click="BarnDoor_Click" Style="{StaticResource TransBtn}" Background="#334155" BorderBrush="#64748B" Margin="2,0,0,0">
                            <TextBlock Text="BARNDOOR" FontSize="10" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Transition Duration Selector -->
                    <Border Grid.Row="1" Background="#20242D" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                        <Grid>
                            <TextBlock Text="DURATION:" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="DurationMinus_Click" Content="-" Width="20" Height="20" Background="#2B303C" Foreground="#FFF" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand"/>
                                <TextBlock x:Name="DurationText" Text="500 ms" Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                <Button Click="DurationPlus_Click" Content="+" Width="20" Height="20" Background="#2B303C" Foreground="#FFF" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- T-BAR SLIDER AREA -->
                    <Grid Grid.Row="2" Margin="0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="T-BAR TRANSITION" Foreground="#64748B" FontSize="9" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <Slider x:Name="TBarSlider" Grid.Row="1" Style="{StaticResource BroadcastTBarSlider}" Minimum="0" Maximum="1" Value="0"
                                TickFrequency="0.1" IsSnapToTickEnabled="False"
                                ValueChanged="TBarSlider_ValueChanged"
                                HorizontalAlignment="Center" Cursor="Hand" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="POS: " Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TBarValText" Text="0%" Foreground="#F59E0B" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- FTB Button -->
                    <Button x:Name="FtbBtn" Grid.Row="3" Click="Ftb_Click" Style="{StaticResource TransBtn}" Background="#450A0A" BorderBrush="#DC2626" Height="32" Margin="0,4,0,0">
                        <TextBlock x:Name="FtbText" Text="FTB (FADE TO BLACK)" FontSize="10" FontWeight="Black" Foreground="#FCA5A5"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. PROGRAM MONITOR -->
            <Border Grid.Column="2" Background="#14161C" BorderBrush="#EF4444" BorderThickness="2" CornerRadius="4" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- Program Header Bar with LED Tally Badge -->
                    <Border Grid.Row="0" Background="#181B22" BorderBrush="#252A36" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid>
                            <Border HorizontalAlignment="Left" Background="#7F1D1D" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,5,0"/>
                                    <TextBlock Text="ON AIR (LIVE)" Foreground="#FFFFFF" FontWeight="Black" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ProgramInputName" Text="2. Studio Clock" Foreground="#F87171" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Program Content Canvas -->
                    <Grid x:Name="ProgramContent" Grid.Row="1" Background="#07080A" ClipToBounds="True">
                        <!-- Main Program Feed -->
                        <controls:InputDisplay x:Name="ProgramDisplay" />

                        <!-- Transition Target Blend Layer -->
                        <controls:InputDisplay x:Name="TransitionTargetDisplay" Opacity="0.0" />

                        <!-- OVERLAYS 1-8: Hardware Composited Real Input Surfaces -->
                        <Grid x:Name="Overlay1Host" Visibility="Collapsed" Opacity="0.0">
                            <controls:InputDisplay x:Name="Overlay1Display" IsOverlayMode="True" />
                        </Grid>
                        <Grid x:Name="Overlay2Host" Visibility="Collapsed" Opacity="0.0">
                            <controls:InputDisplay x:Name="Overlay2Display" IsOverlayMode="True" />
                        </Grid>
                        <Grid x:Name="Overlay3Host" Visibility="Collapsed" Opacity="0.0">
                            <controls:InputDisplay x:Name="Overlay3Display" IsOverlayMode="True" />
                        </Grid>
                        <Grid x:Name="Overlay4Host" Visibility="Collapsed" Opacity="0.0">
                            <controls:InputDisplay x:Name="Overlay4Display" IsOverlayMode="True" />
                        </Grid>
                        <Grid x:Name="Overlay5Host" Visibility="Collapsed" Opacity="0.0">
                            <controls:InputDisplay x:Name="Overlay5Display" IsOverlayMode="True" />
                        </Grid>
                        <Grid x:Name="Overlay6Host" Visibility="Collapsed" Opacity="0.0">
                            <controls:InputDisplay x:Name="Overlay6Display" IsOverlayMode="True" />
                        </Grid>
                        <Grid x:Name="Overlay7Host" Visibility="Collapsed" Opacity="0.0">
                            <controls:InputDisplay x:Name="Overlay7Display" IsOverlayMode="True" />
                        </Grid>
                        <Grid x:Name="Overlay8Host" Visibility="Collapsed" Opacity="0.0">
                            <controls:InputDisplay x:Name="Overlay8Display" IsOverlayMode="True" />
                        </Grid>

                        <!-- Fade To Black Mask -->
                        <Rectangle x:Name="FtbMask" Fill="#000000" Opacity="0.0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Program Footer -->
                    <Border Grid.Row="2" Background="#16181F" Padding="8,2">
                        <Grid>
                            <TextBlock Text="MASTER PROGRAM OUTPUT" Foreground="#64748B" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PgmStatsText" Text="REC: OFF • STREAM: OFF" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. AUDIO MIXER PANEL -->
            <Border Grid.Column="3" Background="#191B22" BorderBrush="#272B35" BorderThickness="1" CornerRadius="4" Margin="4,0,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Master + Bus A section -->
                        <RowDefinition Height="*"/>
                        <!-- Mute Controls -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AUDIO MIXER" Foreground="#E2E8F0" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <!-- Busses (Master and Bus A) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Master Channel -->
                            <ColumnDefinition Width="*"/>
                            <!-- Bus A Channel -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- MASTER STRIP -->
                        <Border Grid.Column="0" Background="#20232B" BorderBrush="#2B303C" BorderThickness="1" CornerRadius="3" Margin="0,0,3,0" Padding="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="MASTER" Foreground="#10B981" FontSize="10" FontWeight="Black" HorizontalAlignment="Center"/>

                                <Grid Grid.Row="1" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Dual Stereo VU meter -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="MasterMeterL" Grid.Column="0" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.75" Style="{StaticResource VuProgressBarStyle}" Margin="1,0"/>
                                        <ProgressBar x:Name="MasterMeterR" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.75" Style="{StaticResource VuProgressBarStyle}" Margin="1,0"/>
                                    </Grid>

                                    <!-- Fader Slider -->
                                    <Slider x:Name="MasterFader" Grid.Column="1" Style="{StaticResource BroadcastFaderSlider}" Minimum="0" Maximum="100" Value="85"
                                            ValueChanged="MasterFader_ValueChanged" HorizontalAlignment="Center" Cursor="Hand"/>
                                </Grid>

                                <TextBlock x:Name="MasterDbText" Grid.Row="2" Text="0.0 dB" Foreground="#10B981" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- BUS A STRIP -->
                        <Border Grid.Column="1" Background="#20232B" BorderBrush="#2B303C" BorderThickness="1" CornerRadius="3" Margin="3,0,0,0" Padding="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="BUS A" Foreground="#38BDF8" FontSize="10" FontWeight="Black" HorizontalAlignment="Center"/>

                                <Grid Grid.Row="1" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Dual Stereo VU meter -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="BusAMeterL" Grid.Column="0" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.6" Style="{StaticResource VuProgressBarStyle}" Margin="1,0"/>
                                        <ProgressBar x:Name="BusAMeterR" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.6" Style="{StaticResource VuProgressBarStyle}" Margin="1,0"/>
                                    </Grid>

                                    <Slider x:Name="BusAFader" Grid.Column="1" Style="{StaticResource BroadcastFaderSlider}" Minimum="0" Maximum="100" Value="80"
                                            ValueChanged="BusAFader_ValueChanged" HorizontalAlignment="Center" Cursor="Hand"/>
                                </Grid>

                                <TextBlock x:Name="BusADbText" Grid.Row="2" Text="-2.0 dB" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Mute Buttons -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MasterMuteBtn" Grid.Column="0" Click="MasterMute_Click" Style="{StaticResource TransBtn}" Height="26" Margin="0,0,2,0">
                            <TextBlock x:Name="MasterMuteText" Text="MUTE" FontSize="10" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="BusAMuteBtn" Grid.Column="1" Click="BusAMute_Click" Style="{StaticResource TransBtn}" Height="26" Margin="2,0,0,0">
                            <TextBlock x:Name="BusAMuteText" Text="MUTE A" FontSize="10" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 2: OVERLAYS HARDWARE BAR -->
        <Border Grid.Row="2" Background="#16181F" BorderBrush="#242731" BorderThickness="0,1" Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OVERLAYS:" Foreground="#94A3B8" FontWeight="Black" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="Overlay1Btn" Click="Overlay1_Click" Style="{StaticResource HeaderBtn}" Content="1" Margin="0,0,3,0" MinWidth="32" ToolTip="Overlay 1 (F1)"/>
                <Button x:Name="Overlay2Btn" Click="Overlay2_Click" Style="{StaticResource HeaderBtn}" Content="2" Margin="0,0,3,0" MinWidth="32" ToolTip="Overlay 2 (F2)"/>
                <Button x:Name="Overlay3Btn" Click="Overlay3_Click" Style="{StaticResource HeaderBtn}" Content="3" Margin="0,0,3,0" MinWidth="32" ToolTip="Overlay 3 (F3)"/>
                <Button x:Name="Overlay4Btn" Click="Overlay4_Click" Style="{StaticResource HeaderBtn}" Content="4" Margin="0,0,3,0" MinWidth="32" ToolTip="Overlay 4 (F4)"/>
                <Button x:Name="Overlay5Btn" Click="Overlay5_Click" Style="{StaticResource HeaderBtn}" Content="5" Margin="0,0,3,0" MinWidth="32" ToolTip="Overlay 5 (F5)"/>
                <Button x:Name="Overlay6Btn" Click="Overlay6_Click" Style="{StaticResource HeaderBtn}" Content="6" Margin="0,0,3,0" MinWidth="32" ToolTip="Overlay 6 (F6)"/>
                <Button x:Name="Overlay7Btn" Click="Overlay7_Click" Style="{StaticResource HeaderBtn}" Content="7" Margin="0,0,3,0" MinWidth="32" ToolTip="Overlay 7 (F7)"/>
                <Button x:Name="Overlay8Btn" Click="Overlay8_Click" Style="{StaticResource HeaderBtn}" Content="8" Margin="0,0,8,0" MinWidth="32" ToolTip="Overlay 8 (F8)"/>

                <Button Click="Stinger1_Click" Style="{StaticResource HeaderBtn}" Background="#1E2A38" Foreground="#38BDF8" BorderBrush="#0284C7" Content="⚡ STINGER 1" Margin="0,0,4,0" Padding="8,4" ToolTip="Stinger 1 Transition"/>
                <Button Click="Stinger2_Click" Style="{StaticResource HeaderBtn}" Background="#1E2A38" Foreground="#38BDF8" BorderBrush="#0284C7" Content="⚡ STINGER 2" Margin="0,0,8,0" Padding="8,4" ToolTip="Stinger 2 Transition"/>
                <Button Click="OverlayAllOff_Click" Style="{StaticResource HeaderBtn}" Background="#3B1E1E" Foreground="#FCA5A5" BorderBrush="#7F1D1D" Content="✕ ALL OFF" Margin="0,0,12,0" Padding="8,4" FontWeight="Black" ToolTip="Take all active overlays off"/>

                <Border Background="#1F232B" CornerRadius="3" Padding="8,2">
                    <TextBlock Text="HOTKEYS: [F1-F8: Overlays • Space: Cut • Enter: Fade • 1-9: Input]" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 3: INPUT CATEGORY TABS -->
        <Border Grid.Row="3" Background="#14151B" BorderBrush="#22252F" BorderThickness="0,1" Padding="12,2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CATEGORY:" Foreground="#64748B" FontSize="10" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="CatAllBtn" Click="Category_Click" Tag="All" Style="{StaticResource CatBtn}" Content="ALL" Background="#2B303C" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                <Button Click="Category_Click" Tag="Red" Style="{StaticResource CatBtn}" Content="RED" Foreground="#EF4444" Margin="0,0,4,0"/>
                <Button Click="Category_Click" Tag="Green" Style="{StaticResource CatBtn}" Content="GREEN" Foreground="#10B981" Margin="0,0,4,0"/>
                <Button Click="Category_Click" Tag="Orange" Style="{StaticResource CatBtn}" Content="ORANGE" Foreground="#F59E0B" Margin="0,0,4,0"/>
                <Button Click="Category_Click" Tag="Purple" Style="{StaticResource CatBtn}" Content="PURPLE" Foreground="#A855F7" Margin="0,0,4,0"/>
                <Button Click="Category_Click" Tag="Aqua" Style="{StaticResource CatBtn}" Content="AQUA" Foreground="#06B6D4" Margin="0,0,4,0"/>
                <Button Click="Category_Click" Tag="Blue" Style="{StaticResource CatBtn}" Content="BLUE" Foreground="#3B82F6" Margin="0,0,4,0"/>
            </StackPanel>
        </Border>

        <!-- 4: INPUTS SWITCHER TRAY -->
        <Border Grid.Row="4" Background="#101115" Padding="10,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="InputsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Input Card -->
                            <Border Margin="0,0,8,0" Width="196" Background="#181A21" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="InputCard_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="#292D38"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                <Setter Property="Background" Value="#0E2419"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsProgram}" Value="True">
                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                <Setter Property="Background" Value="#2E1116"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <!-- Header -->
                                        <RowDefinition Height="22"/>
                                        <!-- Mini Live View -->
                                        <RowDefinition Height="76"/>
                                        <!-- Controls Bar -->
                                        <RowDefinition Height="26"/>
                                        <!-- Overlay Quick Row -->
                                        <RowDefinition Height="18"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,2">
                                        <Border HorizontalAlignment="Left" Background="#242833" CornerRadius="2" Padding="5,1">
                                            <TextBlock Text="{Binding Number}" Foreground="#FFFFFF" FontWeight="Black" FontSize="10"/>
                                        </Border>
                                        <Rectangle HorizontalAlignment="Left" Width="4" Height="14" Fill="{Binding CategoryHex}" RadiusX="1" RadiusY="1" Margin="22,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11" Margin="30,0,38,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Click="InputCardSettings_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Input Settings" Padding="3,0">
                                                <TextBlock Text="⚙" Foreground="#94A3B8" FontSize="11"/>
                                            </Button>
                                            <Button Click="InputCardClose_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close Input" Padding="3,0" Margin="2,0,0,0">
                                                <TextBlock Text="✕" Foreground="#F87171" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mini Preview Box with vMix Stereo Audio Meter Bar -->
                                    <Grid Grid.Row="1">
                                        <Border Background="#060709" CornerRadius="2" ClipToBounds="True">
                                            <controls:InputDisplay Item="{Binding}" />
                                        </Border>

                                        <!-- Live Stereo PPM Audio Meter on right edge of preview -->
                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" Margin="0,2,2,2" Background="#80000000">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding AudioLevelL}" Style="{StaticResource VuProgressBarStyle}" Margin="0.5,0"/>
                                            <ProgressBar Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding AudioLevelR}" Style="{StaticResource VuProgressBarStyle}" Margin="0.5,0"/>
                                        </Grid>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Click="InputCardCut_Click" Tag="{Binding}" Background="#991B1B" Foreground="#FFF" BorderThickness="0" Margin="0,0,2,0" Cursor="Hand">
                                            <TextBlock Text="CUT" FontSize="10" FontWeight="Black"/>
                                        </Button>

                                        <Button Grid.Column="1" Click="InputCardPlay_Click" Tag="{Binding}" Background="#047857" Foreground="#FFF" BorderThickness="0" Margin="2,0,2,0" Cursor="Hand">
                                            <TextBlock Text="QUICK PLAY" FontSize="9" FontWeight="Bold"/>
                                        </Button>

                                        <Button Grid.Column="2" Click="InputCardPlayPause_Click" Tag="{Binding}" Background="#2B303C" Foreground="#FFF" BorderThickness="0" Margin="2,0,2,0" Cursor="Hand" ToolTip="Play / Pause Media">
                                            <TextBlock Text="⏯" FontSize="8"/>
                                        </Button>

                                        <Button Grid.Column="3" Click="InputCardAudio_Click" Tag="{Binding}" Background="#334155" Foreground="#FFF" BorderThickness="0" Margin="2,0,0,0" Cursor="Hand" ToolTip="Toggle Audio Mute">
                                            <TextBlock Text="🔊" FontSize="8"/>
                                        </Button>
                                    </Grid>

                                    <!-- Overlay assignment indicators (1, 2, 3, 4) -->
                                    <Grid Grid.Row="3" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Click="CardOverlay_Click" Tag="1" DataContext="{Binding}" Content="1" Style="{StaticResource CardOverlay1BtnStyle}" ToolTip="Toggle Overlay 1"/>
                                        <Button Grid.Column="1" Click="CardOverlay_Click" Tag="2" DataContext="{Binding}" Content="2" Style="{StaticResource CardOverlay2BtnStyle}" ToolTip="Toggle Overlay 2"/>
                                        <Button Grid.Column="2" Click="CardOverlay_Click" Tag="3" DataContext="{Binding}" Content="3" Style="{StaticResource CardOverlay3BtnStyle}" ToolTip="Toggle Overlay 3"/>
                                        <Button Grid.Column="3" Click="CardOverlay_Click" Tag="4" DataContext="{Binding}" Content="4" Style="{StaticResource CardOverlay4BtnStyle}" ToolTip="Toggle Overlay 4"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 5: STATUS TELEMETRY FOOTER -->
        <Border Grid.Row="5" Background="#14151B" BorderBrush="#22252F" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="StatusLeftText" Text="Ready | Web API: http://localhost:8088/api | TCP: port 8099 | Remote: http://localhost:8088/controller" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock Text="Openmiks v29.0 Pro • Native WPF .NET 10 • 0 Drops • 60 FPS" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
