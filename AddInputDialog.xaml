<Window x:Class="VMixClone.AddInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Select - Openmiks"
        Icon="pack://application:,,,/Assets/openmiks_icon.png"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#14151B" Foreground="#F3F4F6">

    <Window.Resources>
        <Style x:Key="CategoryNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTxtBox" TargetType="TextBox">
            <Setter Property="Background" Value="#161618"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#38383E"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="InputCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Left Categories List -->
                <ColumnDefinition Width="185"/>
                <!-- Right Settings Details -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories Sidebar -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#2A2A30" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8">
                        <Button Click="Nav_Click" Tag="Video" Style="{StaticResource CategoryNavBtn}" Content="🎬 Video"/>
                        <Button Click="Nav_Click" Tag="Camera" Style="{StaticResource CategoryNavBtn}" Content="📷 Live Camera"/>
                        <Button Click="Nav_Click" Tag="Desktop" Style="{StaticResource CategoryNavBtn}" Content="🖥️ Desktop Capture"/>
                        <Button Click="Nav_Click" Tag="Image" Style="{StaticResource CategoryNavBtn}" Content="🖼️ Image / Photos"/>
                        <Button Click="Nav_Click" Tag="Audio" Style="{StaticResource CategoryNavBtn}" Content="🎵 Audio File"/>
                        <Button Click="Nav_Click" Tag="AudioDevice" Style="{StaticResource CategoryNavBtn}" Content="🎤 Audio Input"/>
                        <Button Click="Nav_Click" Tag="Title" Style="{StaticResource CategoryNavBtn}" Content="🏷️ Title / XAML"/>
                        <Button Click="Nav_Click" Tag="Colour" Style="{StaticResource CategoryNavBtn}" Content="🎨 Colour / ColorBars"/>
                        <Button Click="Nav_Click" Tag="Clock" Style="{StaticResource CategoryNavBtn}" Content="⏱️ Studio Clock"/>
                        <Button Click="Nav_Click" Tag="Web" Style="{StaticResource CategoryNavBtn}" Content="🌐 Web Browser"/>
                        <Button Click="Nav_Click" Tag="VirtualSet" Style="{StaticResource CategoryNavBtn}" Content="🏢 Virtual Set"/>
                        <Button Click="Nav_Click" Tag="Playout" Style="{StaticResource CategoryNavBtn}" Content="🎬 Playlist / Slideshow"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Category Specific Options Panel -->
            <Border Grid.Column="1" Padding="20">
                <Grid>
                    <!-- 1. VIDEO -->
                    <StackPanel x:Name="VideoPanel" Visibility="Visible">
                        <TextBlock Text="VIDEO INPUT" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Video File Path (MP4, AVI, MKV, WMV, MOV):" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VideoPathBox" Grid.Column="0" Style="{StaticResource InputTxtBox}"/>
                            <Button Grid.Column="1" Content="Browse..." Click="BrowseVideo_Click" Padding="12,5" Margin="6,0,0,0" Background="#333338" Foreground="#FFF" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <CheckBox x:Name="VideoLoopCheck" Content="Automatically Loop Video Playback" IsChecked="True" Foreground="#FFF" Margin="0,0,0,12"/>
                        <CheckBox x:Name="VideoAutoPlayCheck" Content="Automatically play when transitioned to Program" IsChecked="True" Foreground="#FFF" Margin="0,0,0,16"/>

                        <Border Background="#161618" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="4" Padding="12">
                            <TextBlock Text="DirectShow &amp; Media Foundation native video playback with hardware acceleration." Foreground="#888" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <!-- 2. CAMERA -->
                    <StackPanel x:Name="CameraPanel" Visibility="Collapsed">
                        <TextBlock Text="LIVE CAMERA &amp; CAPTURE DEVICE" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Camera / Capture Device:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CameraDeviceCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12" />

                        <TextBlock Text="Resolution:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CameraResCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="1920x1080 (Full HD)"/>
                            <ComboBoxItem Content="1280x720 (HD)"/>
                            <ComboBoxItem Content="3840x2160 (4K UHD)"/>
                            <ComboBoxItem Content="640x480 (SD)"/>
                        </ComboBox>

                        <TextBlock Text="Frame Rate:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CameraFpsCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="59.94p"/>
                            <ComboBoxItem Content="60p"/>
                            <ComboBoxItem Content="30p"/>
                            <ComboBoxItem Content="25p"/>
                        </ComboBox>

                        <TextBlock Text="Video Format:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CameraFormatCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="YUY2 (Native Uncompressed)"/>
                            <ComboBoxItem Content="MJPEG (High Speed)"/>
                            <ComboBoxItem Content="NV12"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 3. DESKTOP CAPTURE -->
                    <StackPanel x:Name="DesktopPanel" Visibility="Collapsed">
                        <TextBlock Text="DESKTOP &amp; DISPLAY CAPTURE" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Display Source:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DesktopScreenCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="Primary Display (Entire Screen)"/>
                            <ComboBoxItem Content="Extended Display 2"/>
                        </ComboBox>

                        <CheckBox x:Name="CaptureCursorCheck" Content="Capture Mouse Cursor in video feed" IsChecked="True" Foreground="#FFF" Margin="0,0,0,16"/>

                        <Border Background="#161618" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="4" Padding="12">
                            <TextBlock Text="Real-time 60fps screen mirror capture using native Windows GDI BitBlt compositing." Foreground="#888" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <!-- 4. IMAGE -->
                    <StackPanel x:Name="ImagePanel" Visibility="Collapsed">
                        <TextBlock Text="IMAGE / GRAPHIC INPUT" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Image File Path (PNG, JPG, BMP, WebP):" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ImagePathBox" Grid.Column="0" Style="{StaticResource InputTxtBox}"/>
                            <Button Grid.Column="1" Content="Browse..." Click="BrowseImage_Click" Padding="12,5" Margin="6,0,0,0" Background="#333338" Foreground="#FFF" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>

                    <!-- 5. AUDIO FILE -->
                    <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
                        <TextBlock Text="AUDIO FILE INPUT" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Audio File Path (MP3, WAV, M4A, AAC):" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AudioPathBox" Grid.Column="0" Style="{StaticResource InputTxtBox}"/>
                            <Button Grid.Column="1" Content="Browse..." Click="BrowseAudio_Click" Padding="12,5" Margin="6,0,0,0" Background="#333338" Foreground="#FFF" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <CheckBox x:Name="AudioLoopCheck" Content="Automatically Loop Audio Track" IsChecked="True" Foreground="#FFF" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- 5B. AUDIO INPUT (SOUNDCARD / DIRECTSHOW MICROPHONE) -->
                    <StackPanel x:Name="AudioDevicePanel" Visibility="Collapsed">
                        <TextBlock Text="AUDIO INPUT (SOUNDCARD / MICROPHONE)" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Audio Device (Microphone, Line In, Soundcard, Virtual Cable):" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AudioDeviceCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12" />

                        <TextBlock Text="Channel Routing:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AudioChannelCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,16">
                            <ComboBoxItem Content="Stereo (Ch 1 &amp; 2)" IsSelected="True"/>
                            <ComboBoxItem Content="Mono Left (Ch 1 -> Both)"/>
                            <ComboBoxItem Content="Mono Right (Ch 2 -> Both)"/>
                        </ComboBox>

                        <Border Background="#161618" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="DirectShow Live Ingest:" FontWeight="Bold" Foreground="#DDD" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="Captures live audio stream directly from Windows audio hardware driver or external audio interface with real-time dBFS peak metering." Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 6. TITLE / XAML -->
                    <StackPanel x:Name="TitlePanel" Visibility="Collapsed">
                        <TextBlock Text="TITLE / XAML LOWER THIRD" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Title Style Preset:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TitlePresetCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12" SelectionChanged="TitlePreset_Changed">
                            <ComboBoxItem Content="Lower Third (Breaking News Red)"/>
                            <ComboBoxItem Content="Lower Third (Corporate Navy Blue)"/>
                            <ComboBoxItem Content="Corner Bug (Live HD Logo)"/>
                            <ComboBoxItem Content="Sports Scoreboard"/>
                        </ComboBox>

                        <TextBlock Text="Headline Text:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="HeadlineBox" Style="{StaticResource InputTxtBox}" Text="LIVE BROADCAST" Margin="0,0,0,12"/>

                        <TextBlock Text="Subtitle Text:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="SubtitleBox" Style="{StaticResource InputTxtBox}" Text="vMix Studio Online Production" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- 7. COLOUR -->
                    <StackPanel x:Name="ColourPanel" Visibility="Collapsed">
                        <TextBlock Text="COLOUR / TEST PATTERN" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Preset Pattern / Color:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ColourPresetCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="SMPTE Color Bars (1000Hz Tone)"/>
                            <ComboBoxItem Content="Studio Navy (#1A365D)"/>
                            <ComboBoxItem Content="Crimson News (#742A2A)"/>
                            <ComboBoxItem Content="Forest Green (#22543D)"/>
                            <ComboBoxItem Content="Midnight Purple (#44337A)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 8. STUDIO CLOCK -->
                    <StackPanel x:Name="ClockPanel" Visibility="Collapsed">
                        <TextBlock Text="STUDIO PRODUCTION CLOCK" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Clock Display Format:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ClockFormatCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="SMPTE Timecode (HH:mm:ss:ff)"/>
                            <ComboBoxItem Content="Standard 24-Hour (HH:mm:ss)"/>
                            <ComboBoxItem Content="Standard 12-Hour (hh:mm:ss tt)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 9. WEB BROWSER -->
                    <StackPanel x:Name="WebPanel" Visibility="Collapsed">
                        <TextBlock Text="WEB BROWSER INPUT" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Webpage URL:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="WebUrlBox" Style="{StaticResource InputTxtBox}" Text="https://www.google.com" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- 10. VIRTUAL SET -->
                    <StackPanel x:Name="VirtualSetPanel" Visibility="Collapsed">
                        <TextBlock Text="VIRTUAL SET INPUT" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Select Virtual Studio Set:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VirtualSetCombo" Grid.Column="0" Style="{StaticResource InputCombo}"/>
                            <Button Grid.Column="1" Content="Browse Folder..." Click="BrowseVsFolder_Click" Padding="10,5" Margin="6,0,0,0" Background="#333338" Foreground="#FFF" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Presenter / Talent Camera (with Chroma Key):" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="VsTalentCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12"/>

                        <TextBlock Text="Virtual Screen Content Source:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,16"/>
                        <ComboBox x:Name="VsScreenCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,16"/>

                        <Button Click="OpenVseEditor_Click" Content="🎨 Open Virtual Set Editor (VSE)..." Padding="12,8" Background="#1E3A8A" Foreground="#FFFFFF" BorderBrush="#3B82F6" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- 11. PLAYLIST / PHOTO SLIDESHOW -->
                    <StackPanel x:Name="PlayoutPanel" Visibility="Collapsed">
                        <TextBlock Text="PLAYLIST &amp; PHOTO SLIDESHOW" FontSize="14" FontWeight="Black" Foreground="#00E676" Margin="0,0,0,16"/>

                        <TextBlock Text="Media Folder (videos and/or images):" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PlayoutFolderBox" Grid.Column="0" Style="{StaticResource InputTxtBox}"/>
                            <Button Grid.Column="1" Content="Browse..." Click="BrowsePlayout_Click" Padding="12,5" Margin="6,0,0,0" Background="#333338" Foreground="#FFF" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Mode:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PlayoutModeCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="Video Playlist (plays each clip in order)"/>
                            <ComboBoxItem Content="Photo Slideshow (advances on a timer)"/>
                        </ComboBox>

                        <TextBlock Text="Slideshow interval (seconds):" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PlayoutIntervalCombo" Style="{StaticResource InputCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="5" IsSelected="True"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="30"/>
                        </ComboBox>

                        <CheckBox x:Name="PlayoutLoopCheck" Content="Loop when the list ends" IsChecked="True" Foreground="#FFF" Margin="0,0,0,6"/>
                        <CheckBox x:Name="PlayoutShuffleCheck" Content="Shuffle order" IsChecked="False" Foreground="#FFF" Margin="0,0,0,4"/>

                        <Border Background="#161618" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                            <TextBlock x:Name="PlayoutSummaryText" Text="Pick a folder; only real media files are loaded (mp4/mkv/avi/wmv/mov + png/jpg/bmp/webp)." Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Dialog Buttons -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#2A2A30" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Width="80" Padding="6" Background="#333338" Foreground="#CCCCCC" BorderBrush="#55555C" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="OK" Click="Ok_Click" Width="80" Padding="6" Background="#00C853" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#00E676" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
